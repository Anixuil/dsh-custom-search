{
  "name": "dsh-custom-search",
  "version": "0.4.3",
  "description": "Replace the built-in DeepSeek web search with a configurable engine (SearXNG / Tavily / Exa / Brave / Serper / Bing / Google CSE).",
  "license": "MIT",
  "author": "Anixuil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anixuil/dsh-custom-search.git"
  },
  "homepage": "https://github.com/Anixuil/dsh-custom-search#readme",
  "bugs": {
    "url": "https://github.com/Anixuil/dsh-custom-search/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true }
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "engines.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "search",
    "searxng",
    "tavily",
    "brave",
    "serper",
    "web-search"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
