{
  "name": "dsh-custom-search",
  "version": "0.1.0",
  "description": "Replace the built-in DeepSeek web search with a configurable engine (SearXNG / Tavily / Exa / Brave / Serper / Bing / Google CSE).",
  "license": "MIT",
  "author": "Anixuil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anixuil/dsh-custom-search.git"
  },
  "homepage": "https://github.com/Anixuil/dsh-custom-search#readme",
  "bugs": {
    "url": "https://github.com/Anixuil/dsh-custom-search/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "engines.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "search",
    "searxng",
    "tavily",
    "brave",
    "serper",
    "web-search"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
